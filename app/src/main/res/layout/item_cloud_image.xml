<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="10dp"
    android:textDirection="rtl">

    <ImageView
        android:id="@+id/imgSolution"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:contentDescription="صورة حل"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvImageInfo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="@color/kid_text"
            android:textSize="19.2sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteImageItem"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/kid_error"
            android:text="حذف هذه الصورة"
            android:textColor="@color/white"
            android:textSize="20.2sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
