<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/kid_text"
        android:textSize="21.6sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/kid_text"
        android:textSize="16.8sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteProgressItem"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/kid_error"
        android:text="حذف هذا السجل"
        android:textColor="@color/white"
        android:textSize="20.2sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconTint="@color/white" />
</LinearLayout>
